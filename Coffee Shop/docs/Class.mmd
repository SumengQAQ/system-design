---
config:
  layout: elk
---
classDiagram
direction LR

    %% ============================================================
    %% Model / 领域模型
    %% ============================================================
    namespace Model{
        class CoffeeMachineStatus {
            <<enumerate>>
            IDLE: int
            HIBERNATION: int
            WORKING: int
            FAULT: int
        }

        class OrderStatus {
            <<enumerate>>
            TO_BE_PRODUCTED: int
            IN_PRODUCTION: int
            AWAITING_PICKUP: int
            COMPLETED: int
            CANCELLED: int
        }

        class CoffeeTypes{
            <<enumerate>>
            AMERICANO: int
            LATTE: int
            FLAT_WHITE: int
            CAPPUCCINO: int
            %% 以后要出新品，需要改到数据库内
        }

        class CoffeeMachine {
            <<dataclass(slots=True)>>
            -_serial_number: str
            +waiting_time: int
            +create_at: int
            +consecutive_count: int = 0
            +capacity: float = 0.0
            +status: CoffeeMachineStatus = HIBERNATION
            #__str__(self) str
            %% 出厂序列号不可更改
            %% consecutive_count: 连续制作次数，满5杯触发清洁提醒
        }

        class Order{
            <<dataclass(slots=True)>>
            +id: int | None = None
            +customer_name: str
            +coffee_type: CoffeeTypes
            +create_at: datetime = datetime.now()
            +status: OrderStatus = TO_BE_PRODUCTED
            #__str__(self) str
            %% id 由 MemoryOrderRepository 自增分配
        }
    }

    CoffeeMachine --> CoffeeMachineStatus
    Order --> OrderStatus
    Order --> CoffeeTypes

    %% ============================================================
    %% Ports / 抽象接口（六边形架构的端口）
    %% ============================================================
    namespace Ports{
        class CoffeeMachineRepository {
            <<abstract>>
            +save(coffee_machine: CoffeeMachine) bool
            +delete(coffee_machine: CoffeeMachine) bool
            +get_all() list[CoffeeMachine]
            +get_one(serial_number: str) CoffeeMachine | None
            _exists(serial_number: str) bool
        }

        class OrderRepository {
            <<abstract>>
            +save(order: Order) bool
            +delete(order: Order) bool
            +get_all() list[Order]
            +get_one(id: int) Order | None
            _exists(id: int) bool
        }
    }

    CoffeeMachineRepository --> CoffeeMachine
    OrderRepository --> Order

    %% ============================================================
    %% Repository / 适配器：内存实现
    %% ============================================================
    namespace Repository{
        class MemoryCoffeeMachineRepository {
            -_storage: list[CoffeeMachine]
            +__init__() None
            +save(coffee_machine: CoffeeMachine) bool
            +delete(coffee_machine: CoffeeMachine) bool
            +get_all() list[CoffeeMachine]
            +get_one(serial_number: str) CoffeeMachine | None
            _exists(serial_number: str) bool
            %% save 为 upsert 语义：存在则覆盖，不存在则新增
        }

        class MemoryOrderRepository {
            -_storage: list[Order]
            -_next_id: int
            +__init__() None
            +save(order: Order) bool
            +delete(order: Order) bool
            +get_all() list[Order]
            +get_one(id: int) Order | None
            _exists(id: int) bool
            %% save 为 upsert 语义；id=None 时自动分配自增 ID
            %% 实例变量，每个测试/运行时隔离
        }
    }

    MemoryCoffeeMachineRepository ..|> CoffeeMachineRepository
    MemoryOrderRepository ..|> OrderRepository

    %% ============================================================
    %% Service / 业务逻辑层
    %% ============================================================
    %% 用横切关注点加上日志
    %% 以及加上 @logger.catch
    %% 找来的样例，实际要使用loguru创建日志文件并使用异步写入防止阻塞
