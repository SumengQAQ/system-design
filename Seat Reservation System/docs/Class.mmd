---
config:
  layout: elk
  class:
    hideEmptyMembersBox: true
---
classDiagram
  direction LR

  namespace Model {
    class ReputationScore {
      <<@dataclass(frozen=True, slots=True)>>
      value: int
      add_score(self) ReputationScore
      reduce_score(self, value: int) ReputationScore
      can_reservation(self) bool
    }

    class Student {
      <<@dataclass(kw_only=True, slots=True)>>
      id: str
      name: str
      reputation_score: ReputationScore = ReputationScore(100)
    }

    class ReservationStatus {
      <<Enum>>
      PENDING_CHECK_IN / CHECKED_IN / TEMPORARILY_AWAY / ENDED / EXPIRED / CANCELLED
    }

    class SeatType {
      <<Enum>>
      QUIET / DISCUSSION / COMPUTER
    }

    class Position {
      <<@dataclass(frozen=True, slots=True)>>
      row: int
      column: int
    }

    class TimePeriod {
      <<@dataclass(frozen=True, slots=True)>>
      from_time: datetime
      to_time: datetime
      extend_time_period(self, to_time: datetime) TimePeriod
      overlaps_with(self, other: TimePeriod) bool
    }

    class Reservation {
      <<@dataclass(kw_only=True, slots=True)>>
      id: int
      student_id: str
      timer_id: int
      time_period: TimePeriod
      seat_position: Position
      status: ReservationStatus = PENDING_CHECK_IN
      temporarily_away_available_time: int = 1800
      check_in(self) None
      cancel(self) None
      end(self) None
      expire(self) None
      temporarily_away(self) None
      return_from_away(self) None
      _force_set_status(self, status: ReservationStatus) None
    }

    class Seat {
      <<@dataclass(kw_only=True, slots=True)>>
      on_maintain: bool = False
      type: SeatType
      position: Position
    }
  }

  Position --> Reservation
  ReputationScore --> Student
  ReservationStatus --> Reservation
  TimePeriod --> Reservation
  Student --> Reservation
  Seat --> Reservation
  Position --> Seat
  SeatType --> Seat

  namespace Ports {
    class StudentRepository {
      <<ABC>>
      save(self, student: Student) None
      get_by_id(self, student_id: str) Student
      get_all(self) list[Student]
    }

    class SeatRepository {
      <<ABC>>
      save(self, seat: Seat) None
      get_by_position(self, position: Position) Seat
      get_all(self) list[Seat]
    }

    class ReservationRepository {
      <<ABC>>
      save(self, reservation: Reservation) None
      get_by_id(self, id: int) Reservation
      get_by_student_id(self, student_id: str) list[Reservation]
      get_by_seat_position(self, position: Position) list[Reservation]
      get_by_time_period(self, time_period: TimePeriod) list[Reservation]
      get_all(self) list[Reservation]
    }
  }

  Student ..> StudentRepository
  Position ..> SeatRepository
  Seat ..> SeatRepository
  TimePeriod ..> ReservationRepository
  Reservation ..> ReservationRepository

  class Command {
    <<Generic[T]>>
    cls: type[T]
    command_list: list[Callable]
    __init__(self, cls: type[T]) None
    __call__(self, *args, **kwargs) T
    _push(self, func: Callable, name: str) Callable
    _wrap_methods(self, cls: type[T]) None
  }

  namespace Services {
    class ReservationService {
      _repository: ReservationRepository
      _timer_manager: TimerManager
      __init__(self, repository, timer_manager) None
      reserve(self, student_id, time_period, seat_position) Reservation
      check_in(self, id: int) None
      cancel(self, id: int) None
      end(self, id: int) None
      extend_time_period(self, id: int, seconds: int) None
      countdown_begin(self, id: int) None
      countdown_end(self, id: int) None
    }

    class StudentService {
      _repository: StudentRepository
      __init__(self, repository) None
      add_reputation_score(self, id: str, value: int) None
      reduce_reputation_score(self, id: str, value: int) None
    }

    class SeatService {
      _repository: SeatRepository
      __init__(self, repository) None
      occupy(self, position: Position) None
      unoccupy(self, position: Position) None
      maintain(self, position: Position) None
      fix(self, position: Position) None
    }

    class StudentSeatReservationService {
      <<@Command>>
      _reservation_service: ReservationService
      _student_service: StudentService
      _seat_service: SeatService
      __init__(self, reservation_service, student_service, seat_service, timer_manager) None
      reserve(self, student_id, time_period, seat_position) None
      check_in(self, reservation_id: str) None
      extend_time_period(self, reservation_id: str, seconds: int) None
      temporarily_away(self, reservation_id: str) None
      return_from_away(self, reservation_id: str) None
      reserve_undo(self, student_id, time_period, seat_position) None
      check_in_undo(self, reservation_id: str) None
      extend_time_period_undo(self, reservation_id: str, seconds: int) None
      temporarily_away_undo(self, reservation_id: str) None
      return_from_away_undo(self, reservation_id: str) None
      auto_increase_reputation(self, student_id: str) None
    }
  }

  ReservationRepository --> ReservationService
  TimePeriod ..> ReservationService
  Position ..> ReservationService
  Reservation ..> ReservationService
  TimerManager --> ReservationService

  StudentRepository --> StudentService
  Student ..> StudentService
  ReputationScore ..> StudentService

  SeatRepository --> SeatService
  Position ..> SeatService

  ReservationService --> StudentSeatReservationService
  SeatService --> StudentSeatReservationService
  StudentService --> StudentSeatReservationService
  TimerManager --> StudentSeatReservationService

  namespace Infrastructure {
    class MemoryStudentRepository {
      _students: dict[str, Student]
      save(self, student: Student) None
      get_by_id(self, student_id: str) Student
      get_all(self) list[Student]
    }

    class MemorySeatRepository {
      _seats: dict[Position, Seat]
      save(self, seat: Seat) None
      get_by_position(self, position: Position) Seat
      get_all(self) list[Seat]
    }

    class MemoryReservationRepository {
      _reservations: dict[int, Reservation]
      save(self, reservation: Reservation) None
      get_by_id(self, id: int) Reservation
      get_by_student_id(self, student_id: str) list[Reservation]
      get_by_seat_position(self, position: Position) list[Reservation]
      get_by_time_period(self, time_period: TimePeriod) list[Reservation]
      get_all(self) list[Reservation]
    }

    class Timer {
      <<@dataclass(frozen=True, slots=True)>>
      id: int
      waiting_time: int
      time_based_parameter: dict[str, Any]
      final_parameter: dict[str, Any]
      time_based_trigger: Callable[[dict], None]
      final_trigger: Callable[[dict], None]
      scan_cycle: int = 30
    }

    class TimerManager {
      _timers: dict[int, Timer]
      _threads: dict[int, ThreadingTimer]
      _interrupted: set[int]
      create_timer(self, waiting_time, final_trigger, ...) Timer
      start_timer(self, timer_id: int) None
      interrupt(self, timer_id: int) None
      remove_timer(self, timer_id: int) None
    }

    class Command {
      <<Generic[T]>>
      cls: type[T]
      command_list: list[Callable]
      __init__(self, cls: type[T]) None
      __call__(self, *args, **kwargs) T
      _push(self, func: Callable, name: str) Callable
      _wrap_methods(self, cls: type[T]) None
    }
  }

  StudentRepository ..|> MemoryStudentRepository
  SeatRepository ..|> MemorySeatRepository
  ReservationRepository ..|> MemoryReservationRepository
  Timer --> TimerManager
  StudentSeatReservationService ..> Command

  namespace Exception {
    class DomainError {
      <<Exception>>
    }
    class InfrastructureError {
      <<Exception>>
    }
    class InvalidReservationStateError {
      __init__(self, info, status_from, status_to)
    }
    class InvalidSeatStateError {
      __init__(self, info, status_from, status_to)
    }
    class ReputationScoreOutOfRangeError {
      __init__(self, info, score_value, to)
    }
    class DatabaseConnectionError {
      __init__(self, info)
    }
    class PersistenceError {
      __init__(self, info)
    }
    class DataIntegrityError {
      __init__(self, info)
    }
    class ResourceNotFoundError {
      __init__(self, info)
    }
    class MissingConfigurationError {
      __init__(self, info)
    }
    class InvalidConfigurationError {
      __init__(self, info)
    }
    class ExternalServiceUnavailableError {
      __init__(self, info)
    }
    class ExternalServiceError {
      __init__(self, info)
    }
  }

  DomainError --|> InvalidReservationStateError
  DomainError --|> InvalidSeatStateError
  DomainError --|> ReputationScoreOutOfRangeError
  DomainError --|> ResourceNotFoundError
  InfrastructureError --|> DatabaseConnectionError
  InfrastructureError --|> PersistenceError
  InfrastructureError --|> DataIntegrityError
  InfrastructureError --|> MissingConfigurationError
  InfrastructureError --|> InvalidConfigurationError
  InfrastructureError --|> ExternalServiceUnavailableError
  InfrastructureError --|> ExternalServiceError
