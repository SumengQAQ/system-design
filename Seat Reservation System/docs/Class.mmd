---
config:
  layout: elk
  class:
    hideEmptyMembersBox: true
---
%% 场景： 大学图书馆/自习室，学生可以预约座位、签到、暂离、续约。
%% 业务规则：
%% - 座位分区域（静音区/讨论区/电脑区）
%% - 预约时段最小 1h，最长 4h
%% - 预约后 30 分钟内不签到 → 自动取消 + 扣信用分
%% - 暂离最长 30 分钟，超时自动释放座位
%% - 信用分 < 60 → 本周不能再预约
%% - 管理员可以设置座位维护状态
classDiagram
direction LR
	namespace Model {
    class ReputationScore {
      <<@dataclass(frozen=True, slots=True)>>
      value: int
      %% 校验：value∈[0,100]
      add_score(self) ReputationScore
      reduce_score(self) ReputationScore
      can_reservation(self) bool
      %% 信用分 < 60 → 不能预约
    }

    class Student {
      <<@dataclass(kw_only=True, slots=True)>>
      id: str
      name: str
      %% 校验：教务系统中看看有没有这个学生
      %% 没有单独分出来StudentId这个类来做数据校验
      %% 因为name需要和id联合校验
      reputation_score: ReputationScore = ReputationScore(100)
      %% 加上@property，直接返回reputation_score.value
      %% __eq__和__hash__都用id
    }

    class SeatStatus {
      <<Enum>>
      AVAILABLE / OCCUPIED / MAINTAIN
    }

    class ReservationStatus {
      <<Enum>>
      PENDING_CHECK_IN / CHECKED_IN / ENDED / EXPIRED / CANCELLED
    }

    class SeatType {
      <<Enum>>
      QUIET / DISCUSSION / COMPUTER
    }

    class Position {
      <<@dataclass(frozen=True, slots=True)>>
      row: int
      column: int
    }

    class TimePeriod {
      <<@dataclass(frozen=True, slots=True)>>
      from_time: datetime
      to_time: datetime
      extend_time_period(self, to: datetime) TimePeriod
      %% 校验：from ≤ to，预约时段最小 1h，最长 4h
    }

    class Reservation {
      <<@dataclass(kw_only=True, slots=True)>>
      id: str
      student_id: str
      %% 需要从预约能查到学生，也需要从学生能查到预约
      %% 此处student_id不需要校验，因为是由校验过的学生创建的
      time_period: TimePeriod
      seat_position: Position
      status: ReservationStatus = ReservationStatus.PENDING_CHECK_IN
      temporarily_away_available_time: int = 1800
      %% 直接用秒数就足够了
      %% 当然不应该直接这样写，最好是用配置文件

      check_in(self) None
      cancel(self) None
      end(self) None
      %% 状态机轮转，等我画状态图
      %% 在Service层编排
      %% __eq__和__hash__都用id
    }

    class Seat {
      <<@dataclass(kw_only=True, slots=True)>>
      status: SeatStatus = AVAILABLE
      type: SeatType
      position: Position
      %% 实际上座位不知道自己是什么类型，不知道自己在哪里
      %% 但是这里这样写也不是不行，直接看成元组得了

      occupy(self) None
      unoccupy(self) None
      %% 在Service层编排
      %% __eq__和__hash__都用position
    }
	}

  Position --> Reservation
  ReputationScore --> Student
  ReservationStatus --> Reservation
  TimePeriod --> Reservation
  Student --> Reservation
  Seat --> Reservation
  Position --> Seat
  SeatStatus --> Seat
  SeatType --> Seat

  namespace Ports {
    class StudentRepository {
      <<ABC>>
      save(self, student: Stduent) None
      get_by_id(self, student: Student) Student | None
      get_all(self) list[Student]
    }

    class SeatRepository {
      <<ABC>>
      save(self, seat: Seat) None
      get_by_position(self, position: Position) Seat | None
      get_all(self) list[Seat]
    }

    class ReservationRepository {
      <<ABC>>
      save(self, reservation: Reservation) None
      get_by_id(self, id: str) Reservation | None
      get_by_student(self, student: Student) list[Reservation]
      get_by_seat(self, seat: Seat) list[Reservation]
      get_by_time_period(self, time_period: TimePeriod) list[Reservation]
      get_all(self) list[Reservation]
    }
  }

  Student ..> StudentRepository
  Position ..> SeatRepository
  Seat ..> SeatRepository
  TimePeriod ..> ReservationRepository
  Reservation ..> ReservationRepository

  namespace Service {
    class ReservationService {
      _repository: ReservationRepository
      _event_bus: EventBus
      
      __init__(self, repository: ReservationRepository, event_bus: EventBus) None
      reserve(self, student_id: str, time_period: TimePeriod, seat_position: Position) None
      %% publish一个ReservationCreated或InsufficientReputationScoreEvent
      %% 实际应该是用户处于登录状态才能使用，自动传入student_id
      check_in(self, id: str) None
      cancel(self, id: str) None
      end(self, id: str) None
      extend_time_period(self, id: str, time_period: TimePeriod) None
      %% 校验：起始时间相同 && 终止时间延长 && 终止时间 - 起始时间 ≤ 4h
      %% 这几个本来想publish一个UpdateView事件的，但是没必要，前端负责这部分
      countdown_begin(self, id: str) None
      %% 这里面需要用异步来倒计时
      %% 所以这部分也需要一个事件
      %% publish一个TemporarilyAwayEvent
      %% 之前的方法名是temporarily_waay
      %% 但是我感觉在单独的Service里面还是先控制好结合具体语境的程度
      %% 到了StudentSeatReservationService里面再考虑用暂时离场/离场返回这种说法
      %% 虽然这两个方法目前也不需要跨领域编排，但是还是要注意方法名，尽可能专注于目前的服务
      countdown_end(self, id: str) None
      %% 中断倒计时并重置temporarily_away_available_time
      %% 这里不涉及到其他的部分，不需要事件了
    }

    class StudentService {
      _repository: StudentRepository
      _event_bus: EventBus

      __init__(self, repository: StudentRepository, event_bus: EventBus) None
      %% update_reputation_score(self, id: str, reputation_score: ReputationScore) None
      %% reputation_score的增加是一个异步的周期任务
      %% 当reputation_score减少时，publish一个ReduceReputationScore
      %% 但是这样写也就意味着不能直接指定修改多少
      %% 所以此处直接传入属性值而不是值对象
      add_reputation_score(self, id: str, value: int) None
      reduce_reputation_score(self, id: str, value: int) None
      add_reservation(self, student_id: str, reservation_id: str) None
      delete_reservation(self, student_id: str, reservation_id: str) None
    }

    class SeatService {
      _repository: SeatRepository
      _event_bus: EventBus

      __init__(self, repository: SeatRepository, event_bus: EventBus) None
      occupy(self, position: Position) None
      unoccupy(self, position: Position) None
      maintain(self, position: Position) None
      fix(self, position: Position) None
    }

    class StudentSeatReservationService {
      _event_bus: EventBus

      __init__(self, event_bus: EventBus) None
      %% 写到这里了，对于事件驱动我还不是特别熟
      %% 所以可能需要先补习一下再继续
    }

  }

  EventBus --> ReservationService
  ReservationRepository --> ReservationService
  TimePeriod ..> ReservationService
  Position ..> ReservationService
  Reservation ..> ReservationService

  EventBus --> StudentService
  StudentRepository --> StudentService
  Studnet ..> StudentService
  ReputationScore ..> StudentService

  EventBus --> SeatService
  StudentRepository --> SeatService
  Position ..> SeatService

  ReservationService ..> StudentSeatReservationService
  StudentService ..> StudentSeatReservationService
  SeatService ..> StudentSeatReservationService

  namespace Event {
    class ReservationCreatedEvent {
      id: str
      student_id: str
      time_period: TimePeriod
      seat_position: Position
      status: ReservationStatus
    }
    
    class ReservationCreatedTimeOutEvent {
      id: str
      student_id: str
      time_period: TimePeriod
      seat_position: Position
      status: ReservationStatus
      now_time: datetime = time.now()
    }

    class InsufficientReputationScoreEvent {
      id: str
      name: str
      reputation_score: ReputationScore
    }

    class TemporarilyAwayEvent {
      id: str
      temporarily_away_available_time: int
      %% 接到这个事件的开始倒计时
      %% 倒计时结束后，自动释放座位并标记预约单为已超时
      %% 然后扣除信誉分
    }

    class ReduceReputationScore {
      id: str
      reputation_score: ReputationScore
    }

    %% 虽然有一些已经有相关的Exception了
    %% 但是我觉得Exception只应该负责记录错误日志，不负责输出
    %% 所以还需要有相应的Event来负责输出
    %% 还没写完
  }

  namespace Infrastructure {
    class MemoryStudentRepository {
      _students: dict[str, Student]
      save(self, student: Student) None
      get_by_id(self, student: Student) Student | None
      get_all(self) list[Student]
    }

    class MemorySeatRepository {
      _seats: dict[tuple[int, int], Seat]
      save(self, seat: Seat) None
      get_by_position(self, position: Position) Seat | None
      get_all(self) list[Seat]
    }

    class MemoryReservationRepository {
      _reservations: dict[str, Reservation]
      save(self, reservation: Reservation) None
      get_by_id(self, id: str) Reservation | None
      get_by_student(self, student: Student) list[Reservation]
      get_by_seat(self, seat: Seat) list[Reservation]
      get_by_time_period(self, time_period: TimePeriod) list[Reservation]
      get_all(self) list[Reservation]
    }

    class EventBus {
      <<ABC>>
      register(self, event_type: type, handler: Callable) None
      publish(self, event: object) None
    }
  }

  StudentRepository ..|> MemoryStudentRepository
  Position ..> MemorySeatRepository
  SeatRepository ..|> MemorySeatRepository
  ReservationRepository ..|> MemoryReservationRepository
  TimePeriod ..> MemoryReservationRepository
  %% Student --> MemoryStudentRepository
  %% Seat --> MemorySeatRepository
  %% Reservation --> MemoryReservationRepository

  namespace Exception {
    class StudentInfoError{__init__(self, student_id: str, student_name: str)}
    class TimeError{__init__(self, reservation_id: str, time_period: TimePeriod)}
    class ReputationScoreError{__init__(self, student_id: str, student_reputation_score: int)}
    %% class SeatAlreadyOccupiedError{__init__(self, reservation_id: str, position: Position)}
    %% 异常要有上下文才行，方便溯源
    class ConflictingReservationError{__init__(self, reservation_ids: list[str])}
    %% 当尝试预约的时间段与已预约的时间段重合时
    %% 其实我感觉Already这种可以不定义异常，直接不做出响应就行了
    %% 还没写完
  } 

  Student ..> StudentInfoError
  TimePeriod --> TimeError
  Reservation ..> TimeError
  Student ..> ReputationScoreError
  %% Seat ..> SeatAlreadyOccupiedError
  %% Position ..> SeatAlreadyOccupiedError
  %% Reservation ..> SeatAlreadyOccupiedError
  Reservation ..> ConflictingReservationError
